{
  "name": "tangerine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:gateway": "python3 -m pytest gateway -q",
    "api:types": "openapi-typescript schema/pulp.json -o src/api/schema.d.ts",
    "api:sync": "tsx scripts/fetch-schema.ts",
    "docs:screenshots": "tsx scripts/screenshots.ts",
    "check:access-policies": "PYTHONPATH=gateway python3 scripts/check-access-policies.py",
    "public:sync": "tsx scripts/public-sync.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
